{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "skipLibCheck": true,
  },
  "include": ["src", "types"]
}
